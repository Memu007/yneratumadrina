# Puerto del servidor
PORT=3000

# Credenciales de WhatsApp Cloud API
WHATSAPP_TOKEN=EAAXXXXXXXXXXXXXXXXX
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_VERIFY_TOKEN=tu_token_de_verificacion_personalizado
WHATSAPP_BUSINESS_ACCOUNT_ID=1234567890

# URL pública del webhook (ngrok o dominio real)
WEBHOOK_URL=https://tu-dominio.com/webhook

# App Secret de Meta para validar firma del webhook (X-Hub-Signature-256)
WHATSAPP_APP_SECRET=tu_app_secret_de_meta

# Token de admin para proteger endpoints /test/*
ADMIN_TOKEN=cambiar_esto_en_produccion

# Teléfonos de prueba (con código de país, sin + ni espacios)
TEST_PHONE_MADRINA=5491100000001
TEST_PHONE_AHIJADO=5491100000002

# Nombre de la plantilla utility aprobada en Meta Business Manager
WHATSAPP_TEMPLATE_NAME=goal_sintetico
WHATSAPP_TEMPLATE_LANGUAGE=es_AR
